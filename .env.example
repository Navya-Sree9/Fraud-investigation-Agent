# Copy to .env (git-ignored) and fill in. Loaded automatically via spring.config.import.
FRAUD_LLM_BASE_URL=https://llmgw-wp.tekstac.com
FRAUD_LLM_API_KEY=<your-gateway-key>
# global.anthropic.claude-haiku-4-5-20251001-v1:0 | global.anthropic.claude-sonnet-4-6 | global.anthropic.claude-opus-4-5-20251101-v1:0
FRAUD_LLM_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# rules | spring-ai | langchain4j
FRAUD_PROCESSOR_MODE=spring-ai
# Optional demo-persona passwords (defaults: agent-demo / investigator-demo / reviewer-demo / auditor-demo)
# FRAUD_AGENT_PASSWORD=
# FRAUD_INVESTIGATOR_PASSWORD=
# FRAUD_REVIEWER_PASSWORD=
# FRAUD_AUDITOR_PASSWORD=
# PORT=8080
